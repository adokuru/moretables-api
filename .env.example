APP_NAME=MoreTables
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Frontend base URLs (single source of truth used by every email/link the API generates).
# Set the origin (scheme + host) only; paths are configured per-flow below.
# Examples:
# FRONTEND_URL=https://www.moretables.com
# ADMIN_FRONTEND_URL=https://admin.moretables.com
# RESTAURANT_FRONTEND_URL=https://restaurant.moretables.com
FRONTEND_URL=https://www.moretables.com
ADMIN_FRONTEND_URL=https://admin.moretables.com
RESTAURANT_FRONTEND_URL=https://restaurant.moretables.com

# Optional path overrides per flow. Only set these if a frontend renames a route.
# Defaults (used when unset):
# /reset-password, /change-password, /auth/change-password
# FRONTEND_PASSWORD_RESET_PATH=
# ADMIN_FRONTEND_PASSWORD_RESET_PATH=
# RESTAURANT_FRONTEND_PASSWORD_RESET_PATH=
RESERVATION_UPCOMING_REMINDER_DAYS_BEFORE=3,1
RESERVATION_UPCOMING_REMINDER_WINDOW_MINUTES=60
RESERVATION_NO_SHOW_GRACE_MINUTES=60
RESERVATION_NO_SHOW_SYSTEM_USER_EMAIL=automation@moretables.internal

# Table availability alerts ("Notify me")
AVAILABILITY_ALERT_RENOTIFY_COOLDOWN_MINUTES=30
AVAILABILITY_ALERT_MAX_ACTIVE_PER_USER=20

# WhatsApp Cloud API (Meta) - used for availability alert messages
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
# Meta WhatsApp Phone Number ID used in /{phone-number-id}/messages, not the App ID, WABA ID, or Business Portfolio ID.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Meta app secret (App dashboard -> Settings -> Basic) - used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Any random string; must match the verify token entered when configuring the webhook in Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_AVAILABILITY_ALERT_TEMPLATE=table_availability_alert
WHATSAPP_RESERVATION_CREATED_TEMPLATE=reservation_created
WHATSAPP_RESERVATION_UPDATED_TEMPLATE=reservation_updated
WHATSAPP_RESERVATION_CANCELLED_TEMPLATE=reservation_cancelled
WHATSAPP_RESERVATION_GUEST_ADDED_TEMPLATE=reservation_guest_added
WHATSAPP_RESERVATION_UPCOMING_REMINDER_TEMPLATE=reservation_upcoming_reminder
# Enable only after every reservation template has a dynamic URL button (https://your-frontend/{{1}}) approved in Meta.
WHATSAPP_RESERVATION_TEMPLATES_HAVE_URL_BUTTON=false
# Enable only after the created/updated/upcoming reminder templates have a "Cancel reservation" quick reply button approved in Meta.
WHATSAPP_RESERVATION_TEMPLATES_HAVE_CANCEL_BUTTON=false
WHATSAPP_TEMPLATE_LANGUAGE=en

# Google Sign-In
# GOOGLE_CLIENT_ID is enough for a single app client. Use GOOGLE_CLIENT_IDS for multiple allowed audiences.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# Merchant billing / Paystack
BILLING_PROVIDER=paystack
RESTAURANT_FRONTEND_BILLING_URL=https://restaurant.moretables.com/admin/billing
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=https://restaurant.moretables.com/admin/billing
PAYSTACK_FOUNDATION_PLAN_CODE=PLN_zqdb2nha3i6yyap
PAYSTACK_CORE_PLAN_CODE=PLN_0inctj6fg23qz5g
PAYSTACK_PREMIUM_PLAN_CODE=PLN_z735qx3h37zwjmm

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_CONNECTION=
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
REDIS_QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
CACHE_LIMITER_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_LIMITER_DB=3

# Production Redis baseline:
# CACHE_STORE=redis
# CACHE_LIMITER_STORE=redis-limiter
# SESSION_DRIVER=redis
# SESSION_CONNECTION=sessions
# QUEUE_CONNECTION=redis

# Reverb. These server-side credentials must never be exposed through Expo variables.
REVERB_APP_ID=moretables-local
REVERB_APP_KEY=moretables-local-public-key
REVERB_APP_SECRET=change-this-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Hostnames only. Include the verified native development host; do not use * in production.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# Reverb production baseline:
# REVERB_ALLOWED_ORIGINS=www.moretables.com,restaurant.moretables.com,admin.moretables.com,api.moretables.com
# REVERB_SCALING_ENABLED=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Campaign waitlist (share the target Google Sheet with the service account's client_email).
GOOGLE_SERVICE_ACCOUNT_BASE64=
CAMPAIGN_WAITLIST_SPREADSHEET_ID=
CAMPAIGN_WAITLIST_SHEET_RANGE="Waitlist!A:B"

# Mailgun (set MAIL_MAILER=mailgun and run: composer require symfony/mailgun-mailer)
MAILGUN_DOMAIN=
MAILGUN_SECRET=
# US: api.mailgun.net | EU: api.eu.mailgun.net
MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
